{
  "expo": {
    "name": "SanatanSevaSetu",
    "slug": "SanatanSevaSetu",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/logo.jpg",
    "scheme": "sanatansevasetu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.jpg",
      "bundleIdentifier": "com.sanatansevasetu.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sanatansevasetu.app",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E9",
        "foregroundImage": "./assets/images/logo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.jpg",
      "publicPath": "/"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo1.jpg",
          "color": "#E8731C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6E9",
          "image": "./assets/images/logo1.jpg",
          "imageWidth": 180,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#FFF6E9",
            "image": "./assets/images/logo1.jpg",
            "imageWidth": 180,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe9b6932-a2ab-47f3-97f6-a43c3d50786d"
      }
    }
  }
}
